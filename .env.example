# Copy to .env and fill in. Never commit .env.
FMG_HOST=fmg.example.internal
FMG_USER=svc-api
FMG_PASSWORD=change-me

# TLS: prefer a CA bundle for your FortiManager's certificate...
# FMG_CA_BUNDLE=/etc/ssl/certs/lab-ca.pem
# ...or, for a throwaway lab with a self-signed cert only:
# FMG_VERIFY_SSL=false
# ...or pin the exact certificate by its SHA-256 fingerprint (works with the default self-signed one):
# FMG_FINGERPRINT=AA:BB:CC:...
